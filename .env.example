PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Database connection (Replace with your actual Neon/Postgres URL)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Security (Replace with a long, random string in production)
JWT_SECRET="your-super-secret-jwt-key-here"

# Email Configuration
SMTP_PROVIDER="smtp" # or 'resend'
RESEND_API_KEY="re_your_resend_api_key_here"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password-here"
SMTP_FROM_EMAIL="noreply@nakathata.lk"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Public media uploads: cloudinary (default), r2, or cloudinary-r2-fallback.
# Fallback applies only to explicit Cloudinary upload quota errors, not existing-image delivery.
MEDIA_STORAGE_PROVIDER="cloudinary"
# Invitation studio images only: inherit (default), cloudinary, or r2.
# Set r2 to store new public invitation images in R2 while vendors stay on Cloudinary.
INVITATION_MEDIA_STORAGE_PROVIDER="inherit"
# Configure all fields before selecting r2 or fallback. Keep secrets backend-only.
R2_ACCOUNT_ID=""
R2_BUCKET_NAME=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# HTTPS custom domain origin only; production must not use the development r2.dev URL.
R2_PUBLIC_URL=""
# Monitoring only: Cloudflare API token with Account > Account Analytics > Read,
# scoped to the R2 account. This is separate from the S3 upload credentials.
CLOUDFLARE_R2_ANALYTICS_TOKEN=""
